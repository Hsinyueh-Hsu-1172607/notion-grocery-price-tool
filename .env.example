# Copy this file to .env and fill in your own values. .env is gitignored — never commit real secrets.

# Create an integration at https://www.notion.so/my-integrations to get this
NOTION_API_KEY=

# The page you shared with your integration — used once by setup_notion.py
# to create the "Grocery Prices" database under it. Find it in the page's
# share menu, or from its URL (the 32-character ID before any "?").
NOTION_PARENT_PAGE_ID=
# Printed by `python setup_notion.py` after it creates the database — paste
# it here before running the main app.
NOTION_DATABASE_ID=

# Any random string, used to sign Flask session cookies
FLASK_SECRET_KEY=

# The password that unlocks the app, hashed. Generate it with
# `python set_password.py` and paste the line it prints — never the password
# itself. Without this set, the app refuses every login rather than letting
# anyone in.
APP_PASSWORD_HASH=

# Only needed when running somewhere other than a Mac — off macOS there is no
# Apple Vision framework, and Tesseract alone reads real receipts too poorly
# to rely on. Get a key from the Google Cloud console with the Cloud Vision
# API enabled. Leave blank on a Mac.
GOOGLE_VISION_API_KEY=
